// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  username String
  email    String    @unique
  password String?
  accounts Account[]

  resume            Resume?
  applications      Application[]
  problemProgress   ProblemProgress[]
  codingSubmissions CodingSubmission[]
}

model Account {
  id     Int @id @default(autoincrement())
  userId Int

  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model InterviewSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  role         String
  difficulty   String
  introduction String?  @db.Text
  status       String   @default("active") // "active" | "completed"
  currentQues  Int      @default(0) // 0 = intro stage, 1-10 = questions
  createdAt    DateTime @default(now())

  // Optional context the interviewer tailors questions to (snapshots taken when the interview starts)
  resume         String? @db.Text
  jobDescription String? @db.Text

  // Set while the candidate shares a read-only link to the report
  shareToken String? @unique

  questions InterviewQuestion[]
  report    InterviewReport?
}

model InterviewQuestion {
  id         Int              @id @default(autoincrement())
  sessionId  Int
  session    InterviewSession @relation(fields: [sessionId], references: [id])
  question   String           @db.Text
  answer     String?          @db.Text
  score      Int?
  // Length of the spoken answer, used for speaking-pace stats in the report
  speakingMs Int?
  feedback   String?          @db.Text // Zara's spoken reply during the live turn
  order      Int // 0 = intro, 1-10 = actual questions
  createdAt  DateTime         @default(now())

  // Rubric evaluation written when the report is generated:
  // { verdict, strengths[], gaps[], betterAnswer, rubric: { relevance, depth, clarity, evidence } }
  evaluation Json?
  attempts   AnswerAttempt[]

  @@unique([sessionId, order])
}

/// A retry of one interview question after the report, scored with the same rubric.
model AnswerAttempt {
  id         Int               @id @default(autoincrement())
  questionId Int
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String            @db.Text
  score      Int
  // Same shape as InterviewQuestion.evaluation, plus fixedGaps[]: which earlier gaps this attempt addressed
  evaluation Json
  createdAt  DateTime          @default(now())

  @@index([questionId])
}

model InterviewReport {
  id            Int              @id @default(autoincrement())
  sessionId     Int              @unique
  session       InterviewSession @relation(fields: [sessionId], references: [id])
  overallScore  Int
  communication Int
  technical     Int // fixed typo: "tecnical" → "technical"
  confidence    Int
  summary       String           @db.Text
  improvements  String           @db.Text // JSON array of strings
  strengths     String?          @db.Text // JSON array of strings
  createdAt     DateTime         @default(now())
}

// Jobs Schema 

enum jobType {
  full_time
  part_time
  contract
  internship
  other
}

enum JobCategory {
  startup
  faang
  company
  hft
  other
}

model Job {
  id String @id @default(uuid())

  externalId String? @unique
  source     String

  title         String
  company       String
  companyLetter String
  location      String

  salary    Int?
  salaryMin Int?
  salaryMax Int?

  type     jobType
  category JobCategory

  description String
  skills      String[]

  applyUrl String

  postedAt DateTime

  isVerified Boolean @default(false)
  isSaved    Boolean @default(false)

  createdAt DateTime @default(now())
}

// DSA Schema

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id             String           @id @default(uuid())
  lcId           Int              @unique
  title          String
  difficulty     Difficulty
  topic          String?
  acceptanceRate Float?
  leetcodeUrl    String
  createdAt      DateTime         @default(now())
  companies      ProblemCompany[]
}

model Company {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  domain    String?
  logoUrl   String?
  createdAt DateTime         @default(now())
  problems  ProblemCompany[]
}

model ProblemCompany {
  id         String   @id @default(uuid())
  frequency  Int?
  timeWindow String?
  source     String?
  createdAt  DateTime @default(now())

  problemId String
  companyId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([problemId, companyId, timeWindow])
  @@index([problemId])
  @@index([companyId])
}

// Career tools

/// The candidate's resume as plain text, extracted from the uploaded PDF.
model Resume {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  text      String   @db.Text
  updatedAt DateTime @updatedAt
}

enum ApplicationStage {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// A job the candidate is tracking, from saving it to the final outcome.
model Application {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String? // id from the jobs board, when the application started there
  company   String
  title     String
  url       String?
  location  String?
  notes     String?          @db.Text
  stage     ApplicationStage @default(SAVED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
}

// Practice progress

/// Per-user state of a problem on the DSA sheet.
model ProblemProgress {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId Int // id from the DSA sheet
  solvedAt  DateTime?
  note      String?   @db.Text
  updatedAt DateTime  @updatedAt

  @@unique([userId, problemId])
}

/// A solution submitted in the coding round, with the AI review of it.
model CodingSubmission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   String // slug of the coding problem
  language  String
  code      String   @db.Text
  passed    Int
  total     Int
  score     Int
  // { score, verdict, correctness, timeComplexity, spaceComplexity, strengths[], improvements[], followUp }
  review    Json
  createdAt DateTime @default(now())

  @@index([userId, problem])
}
