// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  username String
  email    String    @unique
  password String?
  accounts Account[]

  interviewReports InterviewReport[]
  roleFeedback     RoleFeedback[]
  feedbackGoal     FeedbackGoal?
}

model Account {
  id     Int @id @default(autoincrement())
  userId Int

  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model InterviewSession {
  id           Int       @id @default(autoincrement())
  userId       Int
  role         String
  difficulty   String
  introduction String?   @db.Text
  status       String    @default("active") // "active" | "completed"
  currentQues  Int       @default(0) // 0 = intro stage, 1-10 = questions
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  questions InterviewQuestion[]
  report    InterviewReport?

  @@index([userId, createdAt])
}

model InterviewQuestion {
  id             Int              @id @default(autoincrement())
  sessionId      Int
  session        InterviewSession @relation(fields: [sessionId], references: [id])
  question       String           @db.Text
  answer         String?          @db.Text
  score          Int?
  feedback       String?          @db.Text // Zara's spoken reaction during the interview
  strongerAnswer String?          @db.Text // Gemini post-interview suggestion
  order          Int // 0 = intro, 1-10 = actual questions
  createdAt      DateTime         @default(now())

  @@unique([sessionId, order])
}

// ── Feedback ────────────────────────────────────────────────────────────────
// Scores in this section are 0-100. Per-question scores on InterviewQuestion stay 0-10
// (they are produced live during the interview) and are scaled when served.

enum ReportStatus {
  PENDING
  READY
  FAILED
}

// One Gemini-generated report per completed interview session ("All feedback" page).
model InterviewReport {
  id        Int              @id @default(autoincrement())
  sessionId Int              @unique
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleSlug  String // interview role slug, e.g. "frontend-engineer" (= roleId in the feedback API)

  status       ReportStatus @default(PENDING)
  overallScore Int          @default(0)

  // Skill breakdown (0-100)
  technical      Int @default(0) // technicalDepth
  communication  Int @default(0)
  problemSolving Int @default(0)
  systemDesign   Int @default(0)
  confidence     Int @default(0)

  summary      String   @default("") @db.Text // feedbackNote
  improvements String   @default("") @db.Text
  topics       String[]
  gaps         Json? // [{ skill, note }] weaknesses spotted in this session
  durationMin  Int      @default(0)

  model     String? // Gemini model that produced the report
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, roleSlug, createdAt])
}

// Materialized per-user, per-role aggregate ("Role feedback" page).
// Recomputed whenever a report for that role becomes READY.
model RoleFeedback {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleSlug String

  sessionCount  Int       @default(0)
  averageScore  Float?
  latestScore   Int?
  bestScore     Int?
  skillAverages Json // { [skillKey]: { average, latest, sessionCount } }
  recurringGaps Json // [{ skill, occurrences, latestScore, note }]
  nextStep      String    @default("")
  lastSessionAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([userId, roleSlug])
}

// A user's practice goal (one per user).
model FeedbackGoal {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetScore Int
  targetDate  DateTime? @db.Date
  label       String
  updatedAt   DateTime  @updatedAt
}

// Jobs Schema 

enum jobType {
  full_time
  part_time
  contract
  internship
  other
}

enum JobCategory {
  startup
  faang
  company
  hft
  other
}

model Job {
  id String @id @default(uuid())

  externalId String? @unique
  source     String

  title         String
  company       String
  companyLetter String
  location      String

  salary    Int?
  salaryMin Int?
  salaryMax Int?

  type     jobType
  category JobCategory

  description String
  skills      String[]

  applyUrl String

  postedAt DateTime

  isVerified Boolean @default(false)
  isSaved    Boolean @default(false)

  createdAt DateTime @default(now())
}

// DSA Schema

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id             String           @id @default(uuid())
  lcId           Int              @unique
  title          String
  difficulty     Difficulty
  topic          String?
  acceptanceRate Float?
  leetcodeUrl    String
  createdAt      DateTime         @default(now())
  companies      ProblemCompany[]
}

model Company {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  domain    String?
  logoUrl   String?
  createdAt DateTime         @default(now())
  problems  ProblemCompany[]
}

model ProblemCompany {
  id         String   @id @default(uuid())
  frequency  Int?
  timeWindow String?
  source     String?
  createdAt  DateTime @default(now())

  problemId String
  companyId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([problemId, companyId, timeWindow])
  @@index([problemId])
  @@index([companyId])
}
