# Backend Environment Variables (Render)

# Server Port (Render sets process.env.PORT automatically; local fallback is 3001)
PORT=3001

# PostgreSQL Database Connection String (Neon / Postgres)
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for authenticating session tokens
JWT_TOKEN="your_super_secret_jwt_token_key"

# Google Gemini API Key for AI question generation & answer evaluation
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key
GROQ_API_KEY="your_groq_api_key_here"

# Allowed Frontend Origin for CORS (e.g. https://devprep.vercel.app or * for open access)
CORS_ORIGIN="https://your-frontend.vercel.app"
