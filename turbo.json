{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "GROQ_API_KEY",
    "NEXT_PUBLIC_API_URL",
    "DATABASE_URL",
    "GEMINI_API_KEY",
    "JWT_TOKEN",
    "CORS_ORIGIN",
    "FRONTEND_URL",
    "PORT",
    "RAPID_API_KEY",
    "REMOTIVE_API_KEY",
    "ADZUNA_API_KEY",
    "COMPONY_LOGO_API",
    "OPENAI_API_KEY",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "GROQ_API_KEY",
        "NEXT_PUBLIC_API_URL",
        "DATABASE_URL",
        "GEMINI_API_KEY",
        "JWT_TOKEN",
        "NODE_ENV"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": [
        "GROQ_API_KEY",
        "NEXT_PUBLIC_API_URL",
        "DATABASE_URL",
        "GEMINI_API_KEY",
        "JWT_TOKEN",
        "CORS_ORIGIN",
        "FRONTEND_URL",
        "PORT"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
